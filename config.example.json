{
  "api_key": "YOUR_API_KEY_HERE",
  "base_url": "https://api.binance.com",
  "dapi_base_url": "https://dapi.binance.com",
  "fapi_ws_url": "wss://fstream.binance.com/ws",
  "spot_ws_url": "wss://ws-api.binance.com:443/ws-api/v3",
  "private_key_path": null,
  "private_key_password": null,
  "secret_key": null,
  "recv_window": 5000,
  "timeout": 10,
  "influx_host": "http://192.168.1.4:8181",
  "influx_database": "fianndata",
  "influx_measurement": "binance_ticker",
  "influx_futures_measurement": "binance_futures",
  "kafka_bootstrap_servers": "localhost:9092",
  "kafka_topic_coin": "binance.mark_price.coin",
  "kafka_topic_usdt": "binance.mark_price.usdt",
  "kafka_topic_futures_trade": "binance.trade.usdt_futures",
  "kafka_topic_spot_trade": "binance.trade.spot",
  "kafka_topic_engine_events": "binance.engine.futures",
  "clickhouse_signal_url": "http://127.0.0.1:8123",
  "clickhouse_database": "default",
  "clickhouse_user": "default",
  "clickhouse_password": "",
  "clickhouse_signal_table": "strategy_signals",
  "clickhouse_signal_where": "strategy_id = 'demo'",
  "clickhouse_timeout": 10,
  "engine_state_db_path": ".state/strategy_engine.db",
  "engine_poll_interval_sec": 1.0,
  "engine_reconcile_interval_sec": 5.0,
  "engine_reconcile_lag_sec": 2,
  "engine_reconcile_batch_size": 200,
  "engine_request_timeout": 10,
  "engine_startup_lookback_ms": 300000,
  "engine_clickhouse_batch_size": 200,
  "engine_max_notional_per_order": 10000.0,
  "engine_max_actions_per_min_symbol": 120,
  "engine_health_host": "127.0.0.1",
  "engine_health_port": 8088,
  "log_level": "INFO"
}
